generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  passwordHash      String
  name              String
  employeeId        String?             @unique
  customRoleId      String?
  siteId            String?
  isActive          Boolean             @default(true)
  lastLogin         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  auditLogs         AuditLog[]
  deletion_requests deletion_requests[]
  notifications     notifications[]
  customRole        CustomRole?         @relation(fields: [customRoleId], references: [id])
  employee          Employee?           @relation("EmployeeUser", fields: [employeeId], references: [id])
  site              Site?               @relation(fields: [siteId], references: [id])
  violations        Violation[]         @relation("ViolationIssuedBy")
  approvedLogs      WasteLog[]          @relation("ApprovedByUser")
  wasteLogs         WasteLog[]          @relation("CreatedByUser")

  @@map("users")
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     String[] @default([])
  users       User[]

  @@map("custom_roles")
}

model Site {
  id             String      @id @default(uuid())
  name           String
  type           SiteType    @default(COOPERATIVE)
  region         String      @default("")
  address        String      @default("")
  lat            Float?
  lng            Float?
  status         SiteStatus  @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  beneficiaries  Int         @default(30)
  cleanliness    String      @default("Good")
  focus          String      @default("")
  gps            String      @default("")
  launched       String      @default("")
  monthlyTonnage Float       @default(0)
  municipalityId String      @default("")
  notes          String      @default("")
  ohsRating      Int         @default(80)
  phase          String      @default("Month 1")
  provinceId     String      @default("")
  subRegionId    String      @default("")
  supervisor     String      @default("")
  ward           String      @default("")
  employees      Employee[]
  stockItems     StockItem[]
  users          User[]
  vehicles       Vehicle[]
  wasteLogs      WasteLog[]

  @@map("sites")
}

model Employee {
  id                    String             @id @default(uuid())
  empNo                 String             @unique
  firstName             String
  lastName              String
  idNumber              String             @default("")
  role                  String             @default("")
  department            String             @default("")
  siteId                String?
  status                EmployeeStatus     @default(ACTIVE)
  email                 String             @default("")
  phone                 String             @default("")
  startDate             DateTime?
  endDate               DateTime?
  dailyRate             Float              @default(0)
  bankName              String             @default("")
  bankAccount           String             @default("")
  bankBranch            String             @default("")
  photo                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  attendancePct         Float              @default(0)
  bloodGroup            String?
  currentAddress        String?
  dateOfBirth           String?
  disability            String             @default("None")
  emergencyName         String?
  emergencyPhone        String?
  emergencyRelationship String?
  epwpEnrolmentDate     String?
  epwpRefNo             String?
  epwpYouth             Boolean            @default(false)
  exitDate              String?
  exitReason            String?
  gender                String?
  incomeBeforeW2W       Float              @default(0)
  loginPassword         String?
  nationality           String             @default("South African")
  onboardStatus         String             @default("Pending")
  permanentAddress      String?
  ppeIssued             Boolean            @default(false)
  race                  String?
  serviceFee            Float              @default(0)
  stipend               Float              @default(0)
  trainingComplete      Int                @default(0)
  uniformIssued         Boolean            @default(false)
  attendances           Attendance[]
  trainings             EmployeeTraining[]
  site                  Site?              @relation(fields: [siteId], references: [id])
  user                  User?              @relation("EmployeeUser")
  violations            Violation[]
  wasteLogs             WasteLog[]         @relation("CollectorLogs")

  @@map("employees")
}

model Attendance {
  id          String           @id @default(uuid())
  employeeId  String
  date        DateTime
  status      AttendanceStatus @default(PRESENT)
  clockIn     DateTime?
  clockOut    DateTime?
  hoursWorked Float?
  notes       String?
  createdAt   DateTime         @default(now())
  employee    Employee         @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@map("attendances")
}

model WasteType {
  id           String     @id @default(uuid())
  name         String     @unique
  category     String     @default("")
  unit         String     @default("kg")
  pricePerUnit Float      @default(0)
  buyer        String     @default("")
  colour       String     @default("#146484")
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  wasteLogs    WasteLog[]

  @@map("waste_types")
}

model WasteLog {
  id           String     @id @default(uuid())
  date         DateTime
  siteId       String?
  wasteTypeId  String?
  quantity     Float
  unit         String     @default("kg")
  pricePerUnit Float      @default(0)
  totalValue   Float      @default(0)
  collectorId  String?
  status       LogStatus  @default(PENDING)
  notes        String?
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  approvedBy   User?      @relation("ApprovedByUser", fields: [approvedById], references: [id])
  collector    Employee?  @relation("CollectorLogs", fields: [collectorId], references: [id])
  createdBy    User?      @relation("CreatedByUser", fields: [createdById], references: [id])
  site         Site?      @relation(fields: [siteId], references: [id])
  wasteType    WasteType? @relation(fields: [wasteTypeId], references: [id])

  @@map("waste_logs")
}

model Vehicle {
  id           String        @id @default(uuid())
  registration String        @unique
  make         String        @default("")
  model        String        @default("")
  year         Int?
  siteId       String?
  status       VehicleStatus @default(OPERATIONAL)
  fuelType     String        @default("")
  lastService  DateTime?
  nextService  DateTime?
  odometerKm   Float?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assignedTo   String        @default("")
  condition    String        @default("Good")
  site         Site?         @relation(fields: [siteId], references: [id])

  @@map("vehicles")
}

model TrainingModule {
  id                String             @id @default(uuid())
  name              String
  description       String             @default("")
  durationHrs       Float              @default(0)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  type              String             @default("MANDATORY")
  employeeTrainings EmployeeTraining[]

  @@map("training_modules")
}

model EmployeeTraining {
  id               String         @id @default(uuid())
  employeeId       String
  trainingModuleId String
  status           TrainingStatus @default(NOT_STARTED)
  completedDate    DateTime?
  expiryDate       DateTime?
  score            Float?
  createdAt        DateTime       @default(now())
  employee         Employee       @relation(fields: [employeeId], references: [id])
  trainingModule   TrainingModule @relation(fields: [trainingModuleId], references: [id])

  @@unique([employeeId, trainingModuleId])
  @@map("employee_trainings")
}

model Transaction {
  id          String          @id @default(uuid())
  date        DateTime
  type        TransactionType
  category    String          @default("")
  description String          @default("")
  amount      Float
  siteId      String?
  reference   String?
  meta        Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("transactions")
}

model EprReport {
  id           String       @id @default(uuid())
  month        Int
  year         Int
  siteId       String?
  totalTonnes  Float        @default(0)
  totalRevenue Float        @default(0)
  status       ReportStatus @default(DRAFT)
  submittedAt  DateTime?
  data         Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([month, year, siteId])
  @@map("epr_reports")
}

model StockItem {
  id        String      @id @default(uuid())
  code      String      @unique
  item      String
  category  String      @default("PPE")
  uom       String      @default("each")
  onHand    Float       @default(0)
  reorderAt Float       @default(0)
  status    StockStatus @default(OK)
  siteId    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  site      Site?       @relation(fields: [siteId], references: [id])

  @@map("stock_items")
}

model Violation {
  id         String            @id @default(uuid())
  employeeId String
  date       DateTime
  type       String
  severity   ViolationSeverity @default(VERBAL)
  issuedById String?
  status     ViolationStatus   @default(OPEN)
  notes      String            @default("")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  employee   Employee          @relation(fields: [employeeId], references: [id])
  issuedBy   User?             @relation("ViolationIssuedBy", fields: [issuedById], references: [id])

  @@map("violations")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model deletion_requests {
  id          String         @id
  reference   String         @unique
  requestedBy String
  reason      String         @default("")
  scope       String         @default("all")
  status      DeletionStatus @default(PENDING)
  notes       String         @default("")
  processedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime
  users       User           @relation(fields: [requestedBy], references: [id])

  @@index([requestedBy])
  @@index([status])
}

model notifications {
  id        String           @id
  userId    String
  type      NotificationType @default(INFO)
  icon      String           @default("📌")
  title     String
  message   String           @default("")
  action    String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  users     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

enum SiteType {
  COOPERATIVE
  DEPOT
  BUYBACK_CENTRE
  IWMC
  MRC
  BBC
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  PROBATION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum LogStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleStatus {
  OPERATIONAL
  MAINTENANCE
  DECOMMISSIONED
  ACTIVE
  UNDER_REPAIR
  INACTIVE
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum TransactionType {
  REVENUE
  EXPENSE
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED_REPORT
  REJECTED_REPORT
}

enum StockStatus {
  OK
  LOW
  OUT
}

enum ViolationSeverity {
  VERBAL
  WRITTEN
  FINAL_WRITTEN
  DISMISSAL
}

enum ViolationStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum DeletionStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}
