# ── Database ──
DATABASE_URL="postgresql://user:password@host:5432/w2w"

# ── Auth ──
# JWT_SECRET MUST be at least 32 characters in production; server refuses to start otherwise.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="8h"

# ── Server ──
PORT=4000
NODE_ENV=development

# ── CORS ──
CORS_ORIGIN="http://localhost:3000"

# ── Bootstrap admin (consumed by `prisma db seed`) ──
# In production, the seed refuses to run unless these are set.
SEED_ADMIN_EMAIL="admin@yourorg.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026StrongPwd"
SEED_ADMIN_NAME="System Administrator"
